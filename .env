# دیتابیس PostgreSQL
DATABASE_URL=postgresql://postgres:admin1234@localhost:5432/SAHAB_Service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=SAHAB_Service

# برنامه
APP_NAME=سیستم مدیریت تعمیرات
DEBUG=True
SECRET_KEY=my-secret-key-12345

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# آپلود
UPLOAD_DIR=./uploads